# ==========================================
# Google Gemini Generative AI Configuration
# ==========================================
# Obtain from Google AI Studio (https://aistudio.google.com/)
# Supports comma-separated keys for automatic failover and rotation (e.g. key1,key2,key3)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ==========================================
# Sanity Studio & Content Lake Configuration
# ==========================================
SANITY_PROJECT_ID=ntxlr356
SANITY_DATASET=production

# Read-access organization token for Sanity Content Lake queries
SANITY_ORGANIZATION_TOKEN=your_sanity_read_token_here

# Optional: Sanity Context MCP Endpoint
SANITY_CONTEXT_MCP_URL=https://mcp.sanity.io
